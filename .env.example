# Copy to .env (docker compose reads .env automatically) and fill in real values.
# .env is gitignored below - never commit real secrets into this file's tracked copy.

# Optional. Enables the translate=true feature (Phase 3 LLM pass). Leave blank to run
# recognition-only - api/config.py fails translate requests with a clean 503, not a crash,
# when this is unset.
ANTHROPIC_API_KEY=

# Your Cloudflare Pages frontend origin(s), comma-separated, e.g.:
#   https://chunomcameraocr.pages.dev
# Needed for the browser's CORS check to pass when web/ is hosted separately from this API.
# "*" is fine for local-LAN-only use (no split hosting) but should be narrowed once you have
# a real Pages URL.
ALLOWED_ORIGINS=*

# Cloudflare Zero Trust dashboard -> Networks -> Tunnels -> (your tunnel) -> the token embedded
# in the `docker run ... cloudflared tunnel run --token <this>` command Cloudflare shows you.
CLOUDFLARE_TUNNEL_TOKEN=
